# Puppy AI configuration
# Copy to .env and fill in the values you need. Nothing here is required for
# milestone 1 (the desktop shell and mascot work offline without any keys).

# --- Cloud AI (added in milestone 4) ---
# Provider key and model for the online AI mode.
PUPPY_CLOUD_API_KEY=
PUPPY_CLOUD_MODEL=

# --- Ollama (added in milestone 4) ---
# Base URL of the local Ollama server and the model to use offline.
PUPPY_OLLAMA_URL=http://localhost:11434
PUPPY_OLLAMA_MODEL=

# --- Tavily web search (added in milestone 5) ---
PUPPY_TAVILY_API_KEY=

# --- Desktop behaviour ---
# Keep the mascot above other windows (true/false).
PUPPY_ALWAYS_ON_TOP=true
