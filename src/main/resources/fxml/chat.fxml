<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/24" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.puppy.controller.ChatController"
      styleClass="panel-card" spacing="10" minWidth="0" minHeight="0">
    <HBox styleClass="panel-header" alignment="CENTER_LEFT" spacing="8">
        <ImageView fx:id="chatMascotView" fitWidth="28" fitHeight="28"
                   preserveRatio="true" smooth="false"/>
        <Label text="Chat" styleClass="panel-title"/>
        <Label text="Session only" styleClass="status-pill"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="History" onAction="#toggleHistory" styleClass="quiet-button"/>
        <Button text="New" onAction="#newConversation" styleClass="quiet-button"/>
        <Button text="_" onAction="#onMinimize" styleClass="window-button"/>
        <Button text="X" onAction="#onClose" styleClass="window-button"/>
    </HBox>
    <HBox spacing="10" VBox.vgrow="ALWAYS" minHeight="0">
        <VBox fx:id="historyPane" styleClass="history-pane" spacing="6"
              visible="false" managed="false" prefWidth="130" minWidth="120">
            <Label text="This session" styleClass="section-title"/>
            <VBox fx:id="historyItems" spacing="4"/>
        </VBox>
        <BorderPane styleClass="chat-body" HBox.hgrow="ALWAYS" minWidth="0">
            <center>
                <VBox spacing="4">
                    <ScrollPane fx:id="messageScroll" fitToWidth="true" hbarPolicy="NEVER"
                                styleClass="message-scroll" VBox.vgrow="ALWAYS">
                        <content>
                            <VBox fx:id="messagesBox" styleClass="messages-box" spacing="8"/>
                        </content>
                    </ScrollPane>
                    <Label fx:id="thinkingLabel" text="Puppy is thinking..."
                           styleClass="muted-copy thinking-label"
                           visible="false" managed="false"/>
                </VBox>
            </center>
            <bottom>
                <HBox styleClass="composer" spacing="8">
                    <TextField fx:id="messageInput" promptText="Type a message..."
                               onAction="#sendMessage" HBox.hgrow="ALWAYS"/>
                    <Button text="Send" onAction="#sendMessage" fx:id="sendButton"
                            styleClass="primary-button"/>
                </HBox>
            </bottom>
        </BorderPane>
    </HBox>
</VBox>
